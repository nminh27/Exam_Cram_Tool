# API keys are normally added in the app (Settings -> AI providers), which writes them here.
# This file is git-ignored. Provider details (model, URL...) live in data/settings.json.
#
# Anthropic Claude (picked up automatically if no provider is configured yet):
ANTHROPIC_API_KEY=
#
# Other providers get one line each, named after the provider id shown in Settings, e.g.
# FINALFORGE_KEY_OPENAI=sk-...
# FINALFORGE_KEY_GEMINI=...
# FINALFORGE_KEY_OPENROUTER=sk-or-...
#
# With no provider at all, Cramtoolfinal runs in Claude Code mode (docs/CLAUDE_CODE_WORKFLOW.md).

# Optional knobs
# FINALFORGE_MODEL=claude-opus-5-5     # default model for a new Anthropic provider
# FINALFORGE_EFFORT_EXTRACT=high       # Claude effort: low | medium | high | xhigh | max
# FINALFORGE_EFFORT_TUTOR=medium
# FINALFORGE_EFFORT_GRADE=low
# FINALFORGE_FALLBACKS=1               # Claude server-side refusal fallback (0 to disable)
# FINALFORGE_PDF_CHUNK_PAGES=60        # split PDFs longer than this
# FINALFORGE_DATA_DIR=./data
