# Copy to .env (or paste your key in the app's Settings page, which writes .env for you).
ANTHROPIC_API_KEY=

# Optional knobs
# FINALFORGE_MODEL=claude-opus-5-5
# FINALFORGE_EFFORT_EXTRACT=high      # low | medium | high | xhigh | max
# FINALFORGE_EFFORT_TUTOR=medium
# FINALFORGE_EFFORT_GRADE=low
# FINALFORGE_CONCURRENCY=4            # parallel Claude calls during analysis
# FINALFORGE_FALLBACKS=1              # server-side refusal fallback (0 to disable)
# FINALFORGE_PDF_CHUNK_PAGES=60       # split PDFs longer than this
# FINALFORGE_DATA_DIR=./data
